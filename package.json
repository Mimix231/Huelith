{
  "name": "huelith-editor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "build": "tsc --noEmit && vite build",
    "verify": "npm run check && npm test && npm run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:browser": "node tests/browser-smoke.cjs && node tests/authoritative-effect-preview.cjs",
    "test:ui": "python tests/ui-e2e.py",
    "clean:obsolete": "node scripts/remove-obsolete.mjs --apply",
    "clean:obsolete:dry": "node scripts/remove-obsolete.mjs --dry-run",
    "test:timeline": "python tests/timeline-css.py",
    "audit:effects": "node scripts/audit-effects.mjs",
    "test:stage-abc": "node --test tests/stage-abc.test.cjs",
    "check:source": "node scripts/validate-source.cjs",
    "test:stage-dh": "node --test tests/stage-dh.test.cjs",
    "test:stage-ij": "node --test tests/stage-ij.test.cjs",
    "test:originals": "node --test tests/creative-originals.test.cjs && node tests/creative-browser.cjs",
    "test:interactive-preview": "node --test tests/archive-preview-regression.test.cjs tests/live-draft-regression.test.cjs && node tests/authoritative-effect-preview.cjs",
    "test:live-draft": "npm run test:interactive-preview",
    "test:live-preview-fidelity": "npm run test:interactive-preview",
    "test:unlimited-fx": "npm run test:interactive-preview",
    "test:aurora": "node --test tests/aurora-settings.test.cjs tests/aurora-def.test.cjs",
    "test:aurora-ghij": "node --test tests/aurora-ghij.test.cjs && node tests/aurora-ghij-browser.cjs",
    "bench:aurora": "node tests/aurora-ghij-browser.cjs",
    "test:aurora-klm": "node --test tests/aurora-klm.test.cjs && node tests/aurora-ghij-browser.cjs",
    "test:aurora-nop": "node --test tests/aurora-nop.test.cjs && node tests/aurora-nop-browser.cjs",
    "test:aurora-qrs": "node --test tests/aurora-qrs.test.cjs && node tests/aurora-qrs-browser.cjs",
    "bench:aurora-qrs": "node tests/aurora-qrs-browser.cjs",
    "test:implementation3": "node --test tests/huelith-implementation3.test.cjs tests/creative-originals.test.cjs && node tests/creative-browser.cjs",
    "release:check": "node scripts/release-gate.mjs",
    "release:source": "node scripts/release-gate.mjs --source-only",
    "test:animation-fx": "node --test tests/animation-persistent-effects.test.cjs tests/version-changelogs.test.cjs && node tests/animation-track-browser.cjs",
    "test:phase-aj": "node --test tests/phase-aj-segmentation.test.cjs && node tests/phase-aj-browser.cjs",
    "test:cutout": "node --test tests/cutout-workspace.test.cjs",
    "test:phase-ak": "node --test tests/phase-ak-gradient.test.cjs && python tests/phase-ak-browser.py",
    "test:phase-al": "node --test tests/phase-al-workspaces.test.cjs && python tests/phase-al-browser.py",
    "test:core-actions": "node --test tests/core-document-actions.test.cjs && python tests/core-document-actions-browser.py && python tests/core-selection-browser.py",
    "test:order2": "node --test tests/order1-gradient-patterns.test.cjs tests/order2-smart-transform.test.cjs && python tests/order2-smart-transform-browser.py",
    "test:brush": "node --test tests/brush-atelier.test.cjs && python tests/brush-atelier-browser.py",
    "test:drawing-tools": "node --test tests/drawing-and-cutout-tools.test.cjs && python tests/drawing-and-cutout-tools-browser.py && python tests/cutout-edit-browser.py",
    "test:cutout-controls": "node --test tests/cutout-control-points.test.cjs && python tests/cutout-control-points-browser.py",
    "test:animation-studio": "node --test tests/animation-studio-2.test.cjs && node tests/animation-track-browser.cjs",
    "test:meme": "node --test tests/meme-creator.test.cjs && python tests/meme-creator-browser.py",
    "test:expansion": "node --test tests/effects-order7.test.cjs",
    "test:expansion:browser": "python tests/expansion-120-browser.py && python tests/blur-color-preservation-browser.py",
    "test:studio-hub": "node --test tests/studio-hub-freeze-regression.test.cjs tests/worker-polish.test.cjs && python tests/worker-exact-scanline-browser.py"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
