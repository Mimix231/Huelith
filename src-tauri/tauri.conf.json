{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Huelith",
  "version": "0.3.0-alpha.0",
  "identifier": "org.huelith.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Huelith",
        "width": 1500,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#101425",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "../public/video-library/": "video-library/", "resources/speech/ggml-base-q5_1.bin":"speech/ggml-base-q5_1.bin", "resources/speech/Release/whisper-cli.exe":"speech/whisper-cli.exe", "resources/speech/Release/whisper.dll":"speech/whisper.dll", "resources/speech/Release/ggml.dll":"speech/ggml.dll", "resources/speech/Release/ggml-base.dll":"speech/ggml-base.dll", "resources/speech/Release/ggml-cpu.dll":"speech/ggml-cpu.dll", "resources/speech/LICENSE-whisper.cpp.txt":"speech/LICENSE-whisper.cpp.txt", "resources/speech/LICENSE-whisper-model.txt":"speech/LICENSE-whisper-model.txt" },
    "windows": {
      "wix": {
        "version": "0.3.0.0"
      }
    },
    "shortDescription": "Free and open source image and vector editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
