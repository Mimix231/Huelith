{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Huelith",
  "version": "0.2.0",
  "identifier": "org.huelith.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Huelith",
        "width": 1500,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#101425",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Free and open source image and vector editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
